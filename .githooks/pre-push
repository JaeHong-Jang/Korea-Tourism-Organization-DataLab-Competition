#!/bin/bash
# main 브랜치 직접 push 방지 hook
# 설치: git config core.hooksPath .githooks

protected_branches=("main")
current_branch=$(git symbolic-ref HEAD | sed -e 's,.*/\(.*\),\1,')

for branch in "${protected_branches[@]}"; do
  if [ "$current_branch" = "$branch" ]; then
    echo ""
    echo "🚫 [ERROR] '$branch' 브랜치에 직접 push할 수 없습니다!"
    echo ""
    echo "  다음 절차를 따라주세요:"
    echo "  1. 작업 브랜치를 생성하세요: git checkout -b feat/이름-작업설명"
    echo "  2. 작업 브랜치에서 커밋 & 푸시하세요"
    echo "  3. GitHub에서 PR을 생성하세요"
    echo ""
    exit 1
  fi
done

exit 0
