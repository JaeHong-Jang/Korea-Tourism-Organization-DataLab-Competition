# ============================================================
# 한국관광공사 데이터랩 활용 경진대회 - .gitignore
# ============================================================

# -------------------- 데이터 --------------------
# 원본 데이터는 절대 커밋하지 않음 (용량 + 저작권)
data/raw/
data/external/
*.csv
*.xlsx
*.xls
*.json
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle

# 전처리 데이터 중 크기가 큰 파일
data/processed/*.csv
data/processed/*.pkl

# -------------------- 모델 --------------------
models/*.pt
models/*.pth
models/*.h5
models/*.pkl
models/*.joblib
models/*.onnx
# 백테스트가 만드는 모델 버전 폴더와 발행 중 임시 폴더(Git 미포함 — 해시는 LEDGER에 기록)
models/v*/
models/g0/
models/.staging-*/
models/.backtest.lock
reports/backtest/.staging-*/
*.model
*.weights

# -------------------- Python --------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/
*.so

# 가상환경
.venv/
venv/
env/
ENV/

# -------------------- Jupyter Notebook --------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# -------------------- IDE --------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# -------------------- 환경 / 시크릿 --------------------
.env
.env.local
*.secret
config.local.yaml

# -------------------- OS --------------------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# -------------------- 기타 --------------------
*.log
*.tmp
*.bak
.cache/

# -------------------- 허용 (위 규칙 예외) --------------------
# 작은 샘플 데이터는 커밋 허용
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
# configs 내 JSON/YAML은 허용
!configs/*.json
!configs/*.yaml
!configs/*.yml
.omc/

# -------------------- 인파예보 추가 규칙 (2026-09-24, T-000) --------------------
# data/ 아래는 README·.gitkeep만 추적한다(원본·가공 데이터는 git 대상 아님)
data/**
!data/**/
!data/**/.gitkeep
!data/**/README.md
# 실행 산출물·로컬 상태
node_modules/
traces/
.harness/logs/
.harness/locks/
.fablize/
.pytest_cache/
.ruff_cache/
apps/web/public/map/
# 전역 *.json·*.csv 규칙의 예외: 설정·계약·공개 산출물은 추적한다
!.harness/*.json
!**/package.json
!**/package-lock.json
!**/tsconfig*.json
!**/composer.json
!**/composer.lock
!**/biome.json
!apps/web/components.json
!packages/contracts/**
!services/*/tests/fixtures/**
!services/*/tests/**/fixtures/**
!services/gateway/evals/**
!apps/web/src/**/*.json
!reports/backtest/*.json
!reports/preregistered/*.csv
# PHP 의존성
vendor/
# 도구 상태 폴더는 위 예외와 관계없이 항상 제외한다(마지막 규칙이 이긴다)
**/.omc/
**/vendor/
# Codex 샌드박스가 쓰기 허용 폴더(--add-dir)에 만드는 보호용 빈 폴더
**/.agents/
**/.codex/
apps/web/public/geo/
# 지도 타일은 잘라 낸 작은 파일만 추적하고, 100MB가 넘는 전국 원본은 제외한다(apps/web/public/tiles/README.md)
apps/web/public/tiles/korea-z13.pmtiles
apps/web/public/tiles/korea-z15.pmtiles
apps/web/public/tiles/원본_안내.txt
# 워크트리의 공유 산출물 링크(심볼릭 링크는 디렉터리 규칙에 안 걸리므로 따로 적는다)
/traces
/reports/runs
/reports/evals
/reports/figures/screens
/reports/figures/perf

# Playwright 실행 결과물(워크트리마다 생김)
**/test-results/
**/playwright-report/
