{
  "name": "@crowdcast/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "인파예보 서비스 연결과 상태 확인 게이트웨이",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "eval:extract": "tsx evals/run-extract-eval.ts",
    "eval:scenario": "node --import tsx evals/run-scenario-eval.ts",
    "build": "tsc --noEmit",
    "lint": "biome check src tests package.json tsconfig.json biome.json"
  },
  "dependencies": {
    "@crowdcast/contracts": "^0.1.0",
    "@hono/node-server": "^2.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "hono": "^4.13.9",
    "ollama": "0.6.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@types/node": "22.18.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
