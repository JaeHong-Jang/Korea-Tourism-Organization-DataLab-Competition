# 문장 검사 revision을 과거로 바꿔 S12 위반을 만든다.
PREFIX cc: <http://crowdcast.local/ont#>
PREFIX id: <http://crowdcast.local/id/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX cito: <http://purl.org/spar/cito/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

DELETE { ?check cc:checksRevision ?revision }
INSERT { ?check cc:checksRevision 0 }
WHERE { ?claim cc:checkedBy ?check . ?check cc:checksRevision ?revision }
