{
    "name": "crowdcast/records",
    "description": "인파예보 기록·문서 서비스",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-pdo_sqlite": "*",
        "opis/json-schema": "^2.4",
        "php-di/php-di": "^7.0",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "CrowdCast\\Records\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CrowdCast\\Records\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress"
    },
    "config": {
        "sort-packages": true
    }
}
