# .env로 복사해서 값을 채운다(.env는 git에 올리지 않는다)
# data.go.kr 일반 인증키(Decoding) — 15101972·15128555·15101578·15012690·15084084·15059468 공통
DATA_GO_KR_KEY=
# 비우면 scripts/dev.mjs가 WSL 기본 게이트웨이(Windows 호스트) → 127.0.0.1 순서로 찾는다
OLLAMA_HOST=
OLLAMA_MODEL_FAST=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_MODEL_WRITE=qwen3:4b-instruct-2507-q4_K_M
# 데모 기준일 고정(YYYY-MM-DD). 비우면 오늘
CROWDCAST_TODAY=
# 1이면 데모 재생 모드를 기본으로
DEMO_MODE=0
# ollama | fake(녹화 응답, 테스트용)
LLM_MODE=ollama
# data/·models/·reports/를 읽고 쓰는 레포 경로(워크트리에서 본 레포를 가리킬 때). 비우면 현재 레포 루트
CROWDCAST_DATA_ROOT=
