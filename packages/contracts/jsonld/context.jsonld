{
  "@context": {
    "@version": 1.1,
    "@base": "http://crowdcast.local/id/",
    "cc": "http://crowdcast.local/ont#",
    "prov": "http://www.w3.org/ns/prov#",
    "cito": "http://purl.org/spar/cito/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "id": "@id",
    "text": "cc:text",
    "rendered": "cc:rendered",
    "claimType": "cc:claimType",
    "status": "cc:status",
    "sessionId": { "@id": "cc:inSession", "@type": "@id" },
    "evidenceIds": { "@id": "cito:citesAsEvidence", "@type": "@id", "@container": "@set" },
    "placeholders": { "@id": "cc:hasPlaceholder", "@container": "@set" },
    "quantityId": { "@id": "cc:quantity", "@type": "@id" },
    "field": "cc:field",
    "name": "cc:name",
    "checks": { "@id": "cc:checkedBy", "@container": "@set" },
    "passed": { "@id": "cc:passed", "@type": "xsd:boolean" },
    "revision": { "@id": "cc:checksRevision", "@type": "xsd:integer" },
    "generatedBy": { "@id": "prov:wasGeneratedBy" },
    "agentId": { "@id": "prov:wasAssociatedWith", "@type": "@id" },

    "title": "dcterms:title",
    "summary": "cc:summary",
    "quantityIds": { "@id": "cc:statesQuantity", "@type": "@id", "@container": "@set" },
    "availableAt": { "@id": "cc:availableAt", "@type": "xsd:date" },
    "observedAt": { "@id": "cc:observedAt", "@type": "xsd:date" },
    "datasetId": { "@id": "cc:derivedFromDataset", "@type": "@id" },
    "publisher": "dcterms:publisher",
    "datalabMenu": "cc:datalabMenu",
    "accessUrl": { "@id": "cc:accessUrl", "@type": "xsd:anyURI" },
    "ruleId": { "@id": "cc:aboutRule", "@type": "@id" },
    "clauseId": { "@id": "cc:basedOnClause", "@type": "@id" },
    "caseEventId": { "@id": "cc:aboutCase", "@type": "@id" },
    "assumptionId": { "@id": "cc:aboutAssumption", "@type": "@id" },
    "modelVersion": "cc:modelVersion",

    "value": { "@id": "cc:value", "@type": "xsd:decimal" },
    "p10": { "@id": "cc:p10", "@type": "xsd:decimal" },
    "p50": { "@id": "cc:p50", "@type": "xsd:decimal" },
    "p90": { "@id": "cc:p90", "@type": "xsd:decimal" },
    "unit": "cc:unit",
    "timeUnit": "cc:timeUnit",
    "spatialScope": "cc:spatialScope",
    "kind": "cc:valueKind",
    "estimated": { "@id": "cc:estimated", "@type": "xsd:boolean" },
    "assumptionIds": { "@id": "cc:dependsOnAssumption", "@type": "@id", "@container": "@set" },

    "eventId": { "@id": "cc:predictedFor", "@type": "@id" },
    "asOf": { "@id": "cc:asOf", "@type": "xsd:date" },
    "dailyMean": { "@id": "cc:dailyMean" },
    "peakConcurrent": { "@id": "cc:peakConcurrent" },
    "predictionRun": { "@id": "prov:wasGeneratedBy" },
    "observationIds": { "@id": "prov:used", "@type": "@id", "@container": "@set" },
    "featureName": "cc:featureName",
    "sigunguCode": { "@id": "cc:aboutRegion", "@type": "@id" },
    "trainRange": "cc:trainRange"
  }
}
