{
  "@context": {
    "@version": 1.1,
    "@base": "http://crowdcast.local/id/",
    "cc": "http://crowdcast.local/ont#",
    "prov": "http://www.w3.org/ns/prov#",
    "cito": "http://purl.org/spar/cito/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "id": "@id",
    "kind": { "@id": "@type", "@type": "@vocab" },
    "data": "cc:DataEvidence",
    "model": "cc:ModelEvidence",
    "rule": "cc:RuleEvidence",
    "case": "cc:CaseEvidence",
    "assumption": "cc:AssumptionEvidence",
    "check": "cc:CheckEvidence",

    "name": "cc:name",
    "title": "dcterms:title",
    "summary": "cc:summary",
    "text": "cc:text",
    "rendered": "cc:rendered",
    "claimType": "cc:claimType",
    "status": "cc:status",
    "modelVersion": "cc:modelVersion",
    "featureName": "cc:featureName",
    "ood": { "@id": "cc:ood", "@type": "xsd:boolean" },

    "asOf": { "@id": "cc:asOf", "@type": "xsd:date" },
    "createdAt": { "@id": "cc:createdAt", "@type": "xsd:dateTime" },
    "availableAt": { "@id": "cc:availableAt", "@type": "xsd:date" },
    "observedAt": { "@id": "cc:observedAt", "@type": "xsd:date" },
    "announcedAt": { "@id": "cc:announcedAt", "@type": "xsd:date" },

    "value": { "@id": "cc:value", "@type": "xsd:decimal" },
    "p10": { "@id": "cc:p10", "@type": "xsd:decimal" },
    "p50": { "@id": "cc:p50", "@type": "xsd:decimal" },
    "p90": { "@id": "cc:p90", "@type": "xsd:decimal" },
    "low": { "@id": "cc:rangeLow", "@type": "xsd:decimal" },
    "high": { "@id": "cc:rangeHigh", "@type": "xsd:decimal" },
    "unit": "cc:unit",
    "timeUnit": "cc:timeUnit",
    "spatialScope": "cc:spatialScope",
    "valueKind": "cc:valueKind",
    "estimated": { "@id": "cc:estimated", "@type": "xsd:boolean" },
    "basis": "cc:basis",
    "note": "cc:note",

    "eventId": { "@id": "cc:predictedFor", "@type": "@id" },
    "forecastId": { "@id": "cc:aboutForecast", "@type": "@id" },
    "sessionId": { "@id": "cc:inSession", "@type": "@id" },
    "datasetId": { "@id": "cc:derivedFromDataset", "@type": "@id" },
    "ruleId": { "@id": "cc:aboutRule", "@type": "@id" },
    "clauseId": { "@id": "cc:mentionsClause", "@type": "@id" },
    "caseEventId": { "@id": "cc:aboutCase", "@type": "@id" },
    "assumptionId": { "@id": "cc:aboutAssumption", "@type": "@id" },
    "quantityIds": { "@id": "cc:statesQuantity", "@type": "@id", "@container": "@set" },
    "assumptionIds": { "@id": "cc:dependsOnAssumption", "@type": "@id", "@container": "@set" },
    "evidenceIds": { "@id": "cito:citesAsEvidence", "@type": "@id", "@container": "@set" },

    "dailyMean": { "@id": "cc:dailyMean" },
    "peakConcurrent": { "@id": "cc:peakConcurrent" },
    "evidence": { "@id": "cc:hasEvidence", "@container": "@set" },
    "claims": { "@id": "cc:hasClaim", "@container": "@set" },
    "assumptions": { "@id": "cc:usesAssumption", "@container": "@set" },

    "period": {
      "@id": "cc:period",
      "@context": {
        "from": { "@id": "cc:periodFrom", "@type": "xsd:date" },
        "to": { "@id": "cc:periodTo", "@type": "xsd:date" }
      }
    },
    "source": {
      "@id": "cc:derivedFromDataset",
      "@context": {
        "datasetId": "@id",
        "publisher": "dcterms:publisher",
        "datalabMenu": "cc:datalabMenu",
        "accessUrl": { "@id": "cc:accessUrl", "@type": "xsd:anyURI" }
      }
    },
    "observations": {
      "@id": "cc:hasObservation",
      "@container": "@set",
      "@context": { "sigunguCode": { "@id": "cc:aboutRegion", "@type": "@id" } }
    },
    "predictionRun": {
      "@id": "prov:wasGeneratedBy",
      "@context": {
        "modelRunId": { "@id": "prov:used", "@type": "@id" },
        "observationIds": { "@id": "prov:used", "@type": "@id", "@container": "@set" },
        "trainRange": {
          "@id": "cc:trainRange",
          "@context": {
            "from": { "@id": "cc:periodFrom", "@type": "xsd:date" },
            "to": { "@id": "cc:periodTo", "@type": "xsd:date" }
          }
        }
      }
    },
    "probabilities": {
      "@id": "cc:probabilityOver",
      "@container": "@set",
      "@context": {
        "threshold": { "@id": "cc:threshold", "@type": "xsd:integer" },
        "probability": { "@id": "cc:probability", "@type": "xsd:decimal" },
        "display": "cc:display"
      }
    },
    "judgment": {
      "@id": "cc:hasJudgment",
      "@context": {
        "level": { "@id": "cc:level", "@type": "xsd:integer" },
        "label": "cc:levelLabel",
        "ruleIds": { "@id": "cc:judgedBy", "@type": "@id", "@container": "@set" },
        "reasons": {
          "@id": "cc:hasReason",
          "@container": "@set",
          "@context": {
            "kind": "cc:ruleKind",
            "ruleId": { "@id": "cc:reasonRule", "@type": "@id" },
            "clauseId": { "@id": "cc:reasonClause", "@type": "@id" },
            "evidenceId": { "@id": "cc:reasonEvidence", "@type": "@id" }
          }
        },
        "checklist": {
          "@id": "cc:hasChecklistItem",
          "@container": "@set",
          "@context": {
            "ruleId": { "@id": "cc:checklistRule", "@type": "@id" },
            "evidenceIds": { "@id": "cc:supportedBy", "@type": "@id", "@container": "@set" }
          }
        }
      }
    },
    "factors": {
      "@id": "cc:hasFactor",
      "@container": "@set",
      "@context": {
        "feature": "cc:factorFeature",
        "direction": "cc:direction",
        "contribution": { "@id": "cc:contribution", "@type": "xsd:decimal" },
        "label": "cc:label",
        "evidenceIds": { "@id": "cc:supportedBy", "@type": "@id", "@container": "@set" }
      }
    },
    "placeholders": {
      "@id": "cc:hasPlaceholder",
      "@container": "@set",
      "@context": {
        "quantityId": { "@id": "cc:quantity", "@type": "@id" },
        "field": "cc:field"
      }
    },
    "generatedBy": {
      "@id": "prov:wasGeneratedBy",
      "@context": {
        "@vocab": "http://crowdcast.local/id/agent-",
        "stepId": "@id",
        "agentId": { "@id": "prov:wasAssociatedWith", "@type": "@vocab" }
      }
    },
    "checks": {
      "@id": "cc:checkedBy",
      "@container": "@set",
      "@context": {
        "checkKind": "cc:checkKind",
        "passed": { "@id": "cc:passed", "@type": "xsd:boolean" },
        "revision": { "@id": "cc:checksRevision", "@type": "xsd:integer" }
      }
    },
    "checkResult": {
      "@id": "cc:checkResult",
      "@context": {
        "checkKind": "cc:checkKind",
        "passed": { "@id": "cc:passed", "@type": "xsd:boolean" },
        "revision": { "@id": "cc:checksRevision", "@type": "xsd:integer" }
      }
    },
    "event": {
      "@id": "cc:aboutEvent",
      "@context": {
        "type": "cc:eventTypeLabel",
        "sigunguCode": { "@id": "cc:inRegion", "@type": "@id" },
        "hazards": { "@id": "cc:hazardLabel", "@container": "@set" },
        "startsAt": { "@id": "cc:startsAt", "@type": "xsd:dateTime" },
        "endsAt": { "@id": "cc:endsAt", "@type": "xsd:dateTime" }
      }
    },
    "forecast": { "@id": "cc:reportOf" }
  }
}
