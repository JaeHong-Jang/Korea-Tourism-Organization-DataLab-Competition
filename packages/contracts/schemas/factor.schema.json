{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowdcast.local/schemas/factor.schema.json",
  "title": "예측 요인",
  "description": "SHAP 기여를 요인 문장으로 옮긴 것",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "feature",
    "direction",
    "contribution",
    "label",
    "evidenceIds"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "feature": {
      "type": "string"
    },
    "direction": {
      "enum": [
        "up",
        "down"
      ]
    },
    "contribution": {
      "type": "number",
      "description": "log 규모 기여도"
    },
    "label": {
      "type": "string",
      "description": "템플릿 문장(숫자 없음)"
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 1
    }
  }
}
