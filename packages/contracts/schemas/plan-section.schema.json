{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowdcast.local/schemas/plan-section.schema.json",
  "title": "초안 섹션",
  "description": "body = claimIds의 rendered를 순서대로 줄바꿈(\\n)으로 이은 것(공백 정규화 없음, records가 저장할 때 확인). 잠금 필드는 수치 노드를 가리킨다",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key",
    "title",
    "status",
    "claimIds",
    "body",
    "lockedFields"
  ],
  "properties": {
    "key": {
      "enum": [
        "overview",
        "organization",
        "crowd-timeline",
        "routes-evacuation",
        "staffing",
        "traffic-parking",
        "medical-toilets",
        "weather-emergency",
        "non-crowd-risks"
      ]
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "작성됨",
        "검토 필요"
      ]
    },
    "claimIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/claimId"
      }
    },
    "body": {
      "type": "string"
    },
    "lockedFields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "quantityId"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "quantityId": {
            "$ref": "common.schema.json#/$defs/quantityId"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "const": "작성됨"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "claimIds": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
