{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowdcast.local/schemas/similar-event.schema.json",
  "title": "유사 행사",
  "description": "기록관 결과. 단위가 같을 때만 비교한다",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "name",
    "year",
    "sigunguName",
    "type",
    "measured",
    "announced",
    "unitsComparable",
    "similarity",
    "evidenceId",
    "evidence"
  ],
  "properties": {
    "eventId": {
      "$ref": "common.schema.json#/$defs/eventId"
    },
    "name": {
      "type": "string"
    },
    "year": {
      "type": "integer"
    },
    "sigunguName": {
      "type": "string"
    },
    "type": {
      "$ref": "common.schema.json#/$defs/eventType"
    },
    "measured": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/quantity"
        },
        {
          "type": "null"
        }
      ]
    },
    "announced": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/quantity"
        },
        {
          "type": "null"
        }
      ]
    },
    "unitsComparable": {
      "type": "boolean"
    },
    "similarity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidenceId": {
      "$ref": "common.schema.json#/$defs/evidenceId"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      },
      "minItems": 1
    }
  }
}
