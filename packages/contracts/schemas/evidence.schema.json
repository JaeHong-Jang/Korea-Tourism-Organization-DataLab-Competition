{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowdcast.local/schemas/evidence.schema.json",
  "title": "근거",
  "description": "근거 조각. kind(=그래프 클래스)마다 반드시 채울 필드가 다르다",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "title",
    "summary",
    "quantityIds",
    "period",
    "source",
    "availableAt",
    "ruleId",
    "clauseId",
    "caseEventId",
    "assumptionId",
    "forecastId",
    "modelVersion",
    "checkResult"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/evidenceId"
    },
    "kind": {
      "enum": [
        "data",
        "model",
        "rule",
        "case",
        "assumption",
        "check"
      ]
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "quantityIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/quantityId"
      }
    },
    "period": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/period"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/source"
        },
        {
          "type": "null"
        }
      ]
    },
    "availableAt": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "ruleId": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/ruleId"
        },
        {
          "type": "null"
        }
      ]
    },
    "clauseId": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/clauseId"
        },
        {
          "type": "null"
        }
      ]
    },
    "caseEventId": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/eventId"
        },
        {
          "type": "null"
        }
      ]
    },
    "assumptionId": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/assumptionId"
        },
        {
          "type": "null"
        }
      ]
    },
    "forecastId": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/forecastId"
        },
        {
          "type": "null"
        }
      ]
    },
    "modelVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "checkResult": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "checkKind",
            "passed",
            "revision"
          ],
          "properties": {
            "checkKind": {
              "enum": [
                "evidence",
                "number",
                "rule",
                "uncertainty",
                "ood"
              ]
            },
            "passed": {
              "type": "boolean"
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "data"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "source": {
            "$ref": "common.schema.json#/$defs/source"
          },
          "availableAt": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "period": {
            "$ref": "common.schema.json#/$defs/period"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "rule"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "ruleId": {
            "$ref": "common.schema.json#/$defs/ruleId"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "case"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "caseEventId": {
            "$ref": "common.schema.json#/$defs/eventId"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "assumption"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "assumptionId": {
            "$ref": "common.schema.json#/$defs/assumptionId"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "model"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "modelVersion": {
            "type": "string"
          },
          "forecastId": {
            "$ref": "common.schema.json#/$defs/forecastId"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "check"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "checkResult": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "checkKind",
              "passed",
              "revision"
            ],
            "properties": {
              "checkKind": {
                "enum": [
                  "evidence",
                  "number",
                  "rule",
                  "uncertainty",
                  "ood"
                ]
              },
              "passed": {
                "type": "boolean"
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "forecastId": {
            "$ref": "common.schema.json#/$defs/forecastId"
          }
        }
      }
    }
  ]
}
