{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowdcast.local/schemas/forecast.schema.json",
  "title": "예보(전체)",
  "description": "예측 서비스의 결정적 결과 전체 — 게이트웨이·근거 그래프 내부용. 화면에는 게이트 A 뒤 forecast-card, 발행 뒤 forecast-report로만 나간다",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "eventId",
    "asOf",
    "createdAt",
    "modelVersion",
    "dailyMean",
    "peakConcurrent",
    "probabilities",
    "peakHours",
    "hourlyProfile",
    "composition",
    "judgment",
    "factors",
    "ood",
    "oodReasons",
    "predictionRun",
    "observations",
    "assumptions",
    "evidence"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/forecastId"
    },
    "eventId": {
      "$ref": "common.schema.json#/$defs/eventId"
    },
    "asOf": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/datetime"
    },
    "modelVersion": {
      "type": "string"
    },
    "dailyMean": {
      "$ref": "common.schema.json#/$defs/dailyMeanQuantity"
    },
    "peakConcurrent": {
      "$ref": "common.schema.json#/$defs/peakQuantity"
    },
    "probabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "threshold",
          "probability",
          "display"
        ],
        "properties": {
          "threshold": {
            "type": "integer"
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "display": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "peakHours": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^[0-2][0-9]:[0-5][0-9]$"
            },
            "to": {
              "type": "string",
              "pattern": "^[0-2][0-9]:[0-5][0-9]$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "hourlyProfile": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hour",
          "share"
        ],
        "properties": {
          "hour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          },
          "share": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "composition": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "local",
            "nonlocal",
            "foreign",
            "evidenceId"
          ],
          "properties": {
            "local": {
              "type": "number"
            },
            "nonlocal": {
              "type": "number"
            },
            "foreign": {
              "type": "number"
            },
            "evidenceId": {
              "$ref": "common.schema.json#/$defs/evidenceId"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "judgment": {
      "$ref": "judgment.schema.json"
    },
    "factors": {
      "type": "array",
      "items": {
        "$ref": "factor.schema.json"
      }
    },
    "ood": {
      "type": "boolean"
    },
    "oodReasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "predictionRun": {
      "$ref": "common.schema.json#/$defs/predictionRun"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/observation"
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/assumption"
      },
      "minItems": 2
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      },
      "minItems": 1
    }
  }
}
