{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowdcast.local/schemas/datalab-spec.schema.json",
  "title": "데이터랩 활용 명세",
  "description": "M7-F2 활용 명세표·서식4. 파이프라인이 실제로 읽은 데이터만 행이 된다(확인일 필수)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generatedAt",
    "rows"
  ],
  "properties": {
    "generatedAt": {
      "$ref": "common.schema.json#/$defs/datetime"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "datasetId",
          "title",
          "datalabMenu",
          "metric",
          "period",
          "unit",
          "purpose",
          "usedIn",
          "rowsRead",
          "confirmedAt",
          "evidenceCount"
        ],
        "properties": {
          "datasetId": {
            "$ref": "common.schema.json#/$defs/datasetId"
          },
          "title": {
            "type": "string"
          },
          "datalabMenu": {
            "type": [
              "string",
              "null"
            ],
            "description": "데이터랩 메뉴 경로. data.go.kr API만 쓴 경우 null"
          },
          "metric": {
            "type": "string",
            "description": "지표(예: 외지인 방문자 수)"
          },
          "period": {
            "$ref": "common.schema.json#/$defs/period"
          },
          "unit": {
            "$ref": "common.schema.json#/$defs/unit"
          },
          "purpose": {
            "type": "string",
            "description": "용도(예: 평시 기준선·피처)"
          },
          "usedIn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(M[1-8]-F[0-9]+|G-F[0-9]+)$"
            },
            "minItems": 1,
            "description": "쓰는 기능 id(docs/plan/11)"
          },
          "rowsRead": {
            "type": "integer",
            "minimum": 1
          },
          "confirmedAt": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "evidenceCount": {
            "type": [
              "integer",
              "null"
            ],
            "description": "근거 그래프에서 이 데이터셋을 인용한 근거 수(datalab-usage와 같은 값)"
          }
        }
      }
    }
  }
}
