{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowdcast.local/schemas/plan.schema.json",
  "title": "계획 초안",
  "description": "안전관리계획 초안(참고용)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "forecastId",
    "eventId",
    "title",
    "createdAt",
    "updatedAt",
    "sections",
    "watermark"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "forecastId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "eventId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "title": {
      "type": "string"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/datetime"
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/datetime"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "plan-section.schema.json"
      },
      "minItems": 9,
      "maxItems": 9
    },
    "watermark": {
      "const": "참고용 초안 — 담당자 검토 필수"
    }
  }
}
