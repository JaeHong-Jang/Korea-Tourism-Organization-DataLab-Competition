{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowdcast.local/schemas/judgment.schema.json",
  "title": "판정",
  "description": "판정 엔진 결과. ruleIds = 판정에 쓴 규칙(그래프 cc:judgedBy), 사유 문구는 규칙 결과 템플릿",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "level",
    "label",
    "ruleIds",
    "reasons",
    "checklist"
  ],
  "properties": {
    "level": {
      "$ref": "common.schema.json#/$defs/level"
    },
    "label": {
      "enum": [
        "소규모",
        "수립 권고",
        "수립 대상",
        "대규모"
      ]
    },
    "ruleIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ruleId"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleId",
          "kind",
          "text",
          "clauseId",
          "evidenceId"
        ],
        "properties": {
          "ruleId": {
            "$ref": "common.schema.json#/$defs/ruleId"
          },
          "kind": {
            "enum": [
              "법정",
              "자체"
            ]
          },
          "text": {
            "type": "string"
          },
          "clauseId": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/clauseId"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidenceId": {
            "$ref": "common.schema.json#/$defs/evidenceId"
          }
        },
        "allOf": [
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "법정"
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "clauseId": {
                  "$ref": "common.schema.json#/$defs/clauseId"
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "ruleId",
          "evidenceIds"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/checklistId"
          },
          "text": {
            "type": "string"
          },
          "ruleId": {
            "$ref": "common.schema.json#/$defs/ruleId"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/evidenceId"
            },
            "minItems": 1
          }
        }
      }
    },
    "basis": {
      "enum": [
        "확률",
        "구간"
      ],
      "description": "판정 결과를 보이는 방식. 없으면 확률. 등급·사유는 두 방식 모두 같은 확률 판정(판정 함수 하나)으로 정해지고, 구간(골드 표본이 부족할 때 — 06 §11 G0)은 표시만 바꾼다: 확률 %를 쓰지 않고 순간 최대 p10~p90과 '표본 한계로 구간 기준 표시'를 보인다"
    }
  }
}
